		"main": [
			"gladiatorsarius.coworld.common.CoWorldCommon"
		],
		"server": [
			"gladiatorsarius.coworld.server.CoWorldServer"
		],
		"client": [
			"gladiatorsarius.coworld.client.CoWorldClientClient"
		]
	},
	"mixins": [
		{
			"config": "coworld.mixins.json",
			"environment": "server"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
